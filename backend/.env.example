# WAFA InboxAI — Production PHP 8.2+ Backend Environment Template
# Copy to backend/.env on your production PHP server. NEVER commit real secrets.

APP_ENV=production
APP_URL=https://api.yourdomain.com
ALLOWED_ORIGIN=https://yourdomain.com

# MySQL 8+ PDO Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wafa_inboxai
DB_USER=wafa_db_user
DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD

# 32-byte base64 AES-256-GCM encryption key stored SEPARATELY from database
# Generate via: php -r "echo base64_encode(random_bytes(32));"
APP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# Authenticated HTTP Scheduled Task Runner token (for shared hosting without persistent workers)
CRON_RUNNER_SECRET=CHANGE_ME_RANDOM_64_HEX_TOKEN
